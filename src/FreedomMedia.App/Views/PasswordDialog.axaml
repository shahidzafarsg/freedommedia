<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="FreedomMedia.App.Views.PasswordDialog"
        Title="Passphrase"
        Width="460" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        CanResize="False"
        Background="{StaticResource BgBrush}">
    <StackPanel Margin="26">
        <TextBlock x:Name="TitleText" Text="Enter passphrase" FontSize="18" FontWeight="SemiBold"
                   Foreground="{StaticResource TextBrush}" />
        <TextBlock x:Name="SubText" Text="" FontSize="12.5" TextWrapping="Wrap"
                   Foreground="{StaticResource SubTextBrush}" Margin="0,6,0,18" />

        <TextBlock Text="Passphrase" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,4" />
        <TextBox x:Name="Password1" PasswordChar="●" FontSize="14" />

        <StackPanel x:Name="ConfirmPanel" Margin="0,12,0,0">
            <TextBlock Text="Confirm passphrase" Foreground="{StaticResource SubTextBrush}" FontSize="12" Margin="0,0,0,4" />
            <TextBox x:Name="Password2" PasswordChar="●" FontSize="14" />
        </StackPanel>

        <CheckBox x:Name="ShowBox" Content="Show passphrase" Margin="0,12,0,0" Foreground="{StaticResource SubTextBrush}" />

        <TextBlock x:Name="ErrorText" Foreground="#FF7A7A" FontSize="12" TextWrapping="Wrap"
                   Margin="0,10,0,0" IsVisible="False" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0" Spacing="10">
            <Button Content="Cancel" Click="OnCancel" Width="96" />
            <Button x:Name="OkButton" Classes="primary" Content="OK" Click="OnOk" Width="96" IsDefault="True" />
        </StackPanel>
    </StackPanel>
</Window>
