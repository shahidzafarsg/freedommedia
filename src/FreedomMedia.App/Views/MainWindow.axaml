<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:conv="using:Avalonia.Data.Converters"
        xmlns:vm="using:FreedomMedia.App.Models"
        x:Class="FreedomMedia.App.Views.MainWindow"
        Title="FreedomMedia"
        Width="1180" Height="760"
        MinWidth="820" MinHeight="520"
        Icon="/Assets/freedommedia.ico">

    <Window.KeyBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewVaultCommand}" />
        <KeyBinding Gesture="Ctrl+O" Command="{Binding OpenVaultCommand}" />
        <KeyBinding Gesture="Ctrl+I" Command="{Binding ImportCommand}" />
        <KeyBinding Gesture="Ctrl+E" Command="{Binding ExportCommand}" />
        <KeyBinding Gesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
        <KeyBinding Gesture="Delete" Command="{Binding RemoveCommand}" />
        <KeyBinding Gesture="F2" Command="{Binding RenameCommand}" />
    </Window.KeyBindings>

    <DockPanel>
        <!-- ===== Menu ===== -->
        <Menu DockPanel.Dock="Top">
            <MenuItem Header="_File">
                <MenuItem Header="New Vault…" InputGesture="Ctrl+N" Command="{Binding NewVaultCommand}" />
                <MenuItem Header="Open Vault…" InputGesture="Ctrl+O" Command="{Binding OpenVaultCommand}" />
                <MenuItem Header="Close Vault" Command="{Binding CloseVaultCommand}" />
                <Separator />
                <MenuItem Header="Import Photos or Videos…" InputGesture="Ctrl+I" Command="{Binding ImportCommand}" />
                <MenuItem Header="Export Selected…" InputGesture="Ctrl+E" Command="{Binding ExportCommand}" />
                <Separator />
                <MenuItem Header="Change Passphrase…" Command="{Binding ChangePassphraseCommand}" />
                <Separator />
                <MenuItem Header="Exit" Click="OnExit" />
            </MenuItem>
            <MenuItem Header="_Edit">
                <MenuItem Header="Select All" InputGesture="Ctrl+A" Command="{Binding SelectAllCommand}" />
                <MenuItem Header="Select None" Command="{Binding SelectNoneCommand}" />
                <Separator />
                <MenuItem Header="Rename…" InputGesture="F2" Command="{Binding RenameCommand}" />
                <MenuItem Header="Remove from Vault…" InputGesture="Delete" Command="{Binding RemoveCommand}" />
            </MenuItem>
            <MenuItem Header="_View">
                <MenuItem Header="Icons" Click="OnViewIcons" />
                <MenuItem Header="List" Click="OnViewList" />
                <MenuItem Header="Details" Click="OnViewDetails" />
                <Separator />
                <MenuItem Header="Refresh" Click="OnRefresh" />
            </MenuItem>
            <MenuItem Header="_Help">
                <MenuItem Header="FreedomMedia Help" Click="OnHelp" />
                <MenuItem Header="Visit freedomsoft.uk" Click="OnVisitSite" />
                <Separator />
                <MenuItem Header="About FreedomMedia" Click="OnAbout" />
            </MenuItem>
        </Menu>

        <!-- ===== Toolbar / view bar ===== -->
        <Border DockPanel.Dock="Top" Background="{StaticResource PanelBrush}" Padding="10,7"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <StackPanel Grid.Column="0" Orientation="Horizontal" Spacing="2">
                    <Button Classes="toolbar" Content="New" Command="{Binding NewVaultCommand}" />
                    <Button Classes="toolbar" Content="Open" Command="{Binding OpenVaultCommand}" />
                    <Button Classes="toolbar" Content="Close" Command="{Binding CloseVaultCommand}" />
                    <Border Width="1" Background="{StaticResource BorderBrush}" Margin="6,4" />
                    <Button Classes="toolbar" Content="Import" Command="{Binding ImportCommand}" />
                    <Button Classes="toolbar" Content="Export" Command="{Binding ExportCommand}" />
                    <Button Classes="toolbar" Content="Rename" Command="{Binding RenameCommand}" />
                    <Button Classes="toolbar" Content="Remove" Command="{Binding RemoveCommand}" />
                </StackPanel>

                <StackPanel Grid.Column="2" Orientation="Horizontal" Spacing="2">
                    <TextBlock Text="View" Foreground="{StaticResource SubTextBrush}" VerticalAlignment="Center" Margin="0,0,8,0" />
                    <ToggleButton x:Name="IconsToggle" Classes="view" Content="Icons" Click="OnViewIcons" />
                    <ToggleButton x:Name="ListToggle" Classes="view" Content="List" Click="OnViewList" />
                    <ToggleButton x:Name="DetailsToggle" Classes="view" Content="Details" Click="OnViewDetails" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- ===== Status bar ===== -->
        <Border DockPanel.Dock="Bottom" Background="{StaticResource PanelBrush}" Padding="14,6"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0">
            <Grid ColumnDefinitions="Auto,*,Auto">
                <TextBlock x:Name="CountText" Grid.Column="0" Foreground="{StaticResource SubTextBrush}"
                           FontSize="12" VerticalAlignment="Center" Text="No vault open." />
                <TextBlock x:Name="SelectionText" Grid.Column="2" Foreground="{StaticResource SubTextBrush}"
                           FontSize="12" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
            </Grid>
        </Border>

        <!-- ===== Content ===== -->
        <Grid x:Name="ContentRoot">
            <!-- Welcome (no vault open) -->
            <Border x:Name="WelcomePanel" HorizontalAlignment="Center" VerticalAlignment="Center"
                    Background="{StaticResource PanelBrush}" CornerRadius="14" Padding="44,40" MaxWidth="560">
                <StackPanel Spacing="10" HorizontalAlignment="Center">
                    <Image Source="/Assets/freedommedia.png" Width="84" Height="84" />
                    <TextBlock Text="FreedomMedia" FontSize="26" FontWeight="SemiBold"
                               Foreground="{StaticResource TextBrush}" HorizontalAlignment="Center" />
                    <TextBlock Text="A private, encrypted vault for your photographs and videos, with its own viewer and player. Nothing is decrypted to disk."
                               Foreground="{StaticResource SubTextBrush}" TextWrapping="Wrap" TextAlignment="Center"
                               MaxWidth="420" Margin="0,0,0,10" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10">
                        <Button Classes="primary" Content="Create a Vault" Command="{Binding NewVaultCommand}" />
                        <Button Content="Open a Vault" Command="{Binding OpenVaultCommand}" Padding="16,9" />
                    </StackPanel>
                </StackPanel>
            </Border>

            <!-- Gallery -->
            <Grid x:Name="GalleryRoot" IsVisible="False">
                <!-- Icons -->
                <ListBox x:Name="IconsView" SelectionMode="Multiple" Background="Transparent"
                         BorderThickness="0" Padding="10"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         SelectionChanged="OnSelectionChanged" DoubleTapped="OnItemActivated">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                    <ListBox.Styles>
                        <Style Selector="ListBoxItem">
                            <Setter Property="Padding" Value="4" />
                            <Setter Property="Margin" Value="4" />
                            <Setter Property="CornerRadius" Value="10" />
                        </Style>
                    </ListBox.Styles>
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:MediaItemViewModel">
                            <StackPanel Width="168">
                                <Border Width="168" Height="120" CornerRadius="8" ClipToBounds="True"
                                        Background="{StaticResource PanelBrush2}">
                                    <Grid>
                                        <Image Source="{Binding Thumbnail}" Stretch="UniformToFill"
                                               IsVisible="{Binding Thumbnail, Converter={x:Static conv:ObjectConverters.IsNotNull}}" />
                                        <!-- Placeholder when no thumbnail -->
                                        <Path IsVisible="{Binding Thumbnail, Converter={x:Static conv:ObjectConverters.IsNull}}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center"
                                              Fill="#6B7280" Width="46" Height="46" Stretch="Uniform"
                                              Data="M4 5h16a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H4a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1zm3 3.5A1.5 1.5 0 1 0 7 11.5 1.5 1.5 0 0 0 7 8.5zM5 17l4-4 3 3 4-5 3 6z" />
                                        <!-- Video play badge -->
                                        <Border IsVisible="{Binding IsVideo}" Width="40" Height="40" CornerRadius="20"
                                                Background="#B05B8CFF" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <Path Fill="White" Width="16" Height="16" Stretch="Uniform"
                                                  HorizontalAlignment="Center" VerticalAlignment="Center"
                                                  Data="M8 5v14l11-7z" />
                                        </Border>
                                    </Grid>
                                </Border>
                                <TextBlock Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                           FontSize="12.5" TextTrimming="CharacterEllipsis" MaxWidth="164"
                                           Margin="2,6,2,0" HorizontalAlignment="Center" />
                                <TextBlock Text="{Binding SizeDisplay}" Foreground="{StaticResource SubTextBrush}"
                                           FontSize="11" HorizontalAlignment="Center" />
                            </StackPanel>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- List -->
                <ListBox x:Name="ListView" SelectionMode="Multiple" Background="Transparent"
                         BorderThickness="0" Padding="8" IsVisible="False"
                         SelectionChanged="OnSelectionChanged" DoubleTapped="OnItemActivated">
                    <ListBox.ItemTemplate>
                        <DataTemplate DataType="vm:MediaItemViewModel">
                            <Grid ColumnDefinitions="Auto,*,Auto" Height="30">
                                <Border Grid.Column="0" Width="22" Height="22" CornerRadius="4" Margin="0,0,10,0"
                                        Background="{StaticResource PanelBrush2}">
                                    <Path HorizontalAlignment="Center" VerticalAlignment="Center" Fill="#8B93A1"
                                          Width="13" Height="13" Stretch="Uniform"
                                          Data="M8 5v14l11-7z" IsVisible="{Binding IsVideo}" />
                                </Border>
                                <TextBlock Grid.Column="1" Text="{Binding Title}" Foreground="{StaticResource TextBrush}"
                                           FontSize="13" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                                <TextBlock Grid.Column="2" Text="{Binding SizeDisplay}" Foreground="{StaticResource SubTextBrush}"
                                           FontSize="12" VerticalAlignment="Center" />
                            </Grid>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>

                <!-- Details -->
                <DataGrid x:Name="DetailsGrid" IsVisible="False" Background="Transparent"
                          GridLinesVisibility="Horizontal" BorderThickness="0"
                          IsReadOnly="True" SelectionMode="Extended"
                          CanUserResizeColumns="True" CanUserSortColumns="True"
                          SelectionChanged="OnSelectionChanged" DoubleTapped="OnItemActivated">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Name" Binding="{Binding Title}" Width="3*" />
                        <DataGridTextColumn Header="Type" Binding="{Binding KindLabel}" Width="Auto" />
                        <DataGridTextColumn Header="Size" Binding="{Binding SizeDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="Dimensions" Binding="{Binding DimensionsDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="Duration" Binding="{Binding DurationDisplay}" Width="Auto" />
                        <DataGridTextColumn Header="Added" Binding="{Binding AddedDisplay}" Width="Auto" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- Empty vault hint -->
                <TextBlock x:Name="EmptyHint" IsVisible="False" HorizontalAlignment="Center" VerticalAlignment="Center"
                           Foreground="{StaticResource SubTextBrush}" TextAlignment="Center"
                           Text="This vault is empty.&#x0a;Use Import to add photos or videos." />
            </Grid>
        </Grid>
    </DockPanel>
</Window>
